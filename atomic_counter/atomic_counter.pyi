from datetime import datetime, timedelta
from typing import final

__all__ = ["Counter", "TimeCounter"]

@final
class Counter:
    def __new__(cls, base: int | None = None, now: int | None = None, interval: int | None = None) -> Counter: ...
    def set(self, val: int) -> None: ...
    def current(self) -> int: ...
    def next(self) -> int: ...

@final
class TimeCounter:
    def __new__(cls) -> TimeCounter: ...
    def next(self) -> int: ...
    @staticmethod
    def decode_timestamp_microseconds(value: int) -> int: ...
    def current(self) -> int: ...
    @staticmethod
    def to_datetime(value: int) -> datetime: ...
    @staticmethod
    def get_timedelta(later: int, earlier: int) -> timedelta: ...
